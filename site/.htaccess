# Redirections 301 (audit SEO)
RewriteEngine On
RewriteRule ^www-chalets-lombard-fr-renovation-chalet/?$ /renovation-extension-chalet/ [R=301,L]
RewriteRule ^en/www-chalets-lombard-fr-renovation-chalet/?$ /en/renovation-extension-chalet/ [R=301,L]
RewriteRule ^projets/?$ /realisations/ [R=301,L]
RewriteRule ^en/projets/?$ /en/realisations/ [R=301,L]
RewriteRule ^qui-sommes-nous/?$ /lombard-vasina/ [R=301,L]
RewriteRule ^en/qui-sommes-nous/?$ /en/lombard-vasina/ [R=301,L]
RewriteRule ^constructeur-bois/?$ /savoir-faire/ [R=301,L]
RewriteRule ^en/constructeur-bois/?$ /en/savoir-faire/ [R=301,L]
RewriteRule ^chalets-de-toutes-les-tailles/?$ /realisations/ [R=301,L]
RewriteRule ^en/chalets-de-toutes-les-tailles/?$ /en/realisations/ [R=301,L]
RewriteRule ^home/?$ / [R=301,L]
ErrorDocument 404 /404.html
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
